{
  "name": "market-pulse-gnome-extension",
  "version": "1.0.0",
  "description": "Market Pulse — live stock & crypto quotes, panel ticker, interactive charts, session alerts, and local portfolio P&L tracking for GNOME Shell.",
  "main": "extension.js",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check": "make check",
    "compile-schemas": "glib-compile-schemas --strict schemas/",
    "install": "make install",
    "reinstall": "make reinstall",
    "uninstall": "make uninstall",
    "status": "make status",
    "pack": "make pack",
    "release": "make release",
    "build": "make pack"
  },
  "keywords": [
    "gnome-shell-extension",
    "gnome",
    "stocks",
    "stock-ticker",
    "crypto",
    "bitcoin",
    "portfolio-tracker",
    "gjs"
  ],
  "author": "Shahab Bahreini Jangjoo",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "eslint": "^9.0.0"
  }
}
